[Unit]
Description=MyHealthPredicta Django application
After=network.target

[Service]
User=myhealthpredicta
Group=www-data
WorkingDirectory=/var/www/myhealthpredicta
EnvironmentFile=/etc/myhealthpredicta.env
Environment=DJANGO_SETTINGS_MODULE=myowndissertation.settings_production
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=myhealthpredicta
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/var/www/myhealthpredicta/.venv/bin/gunicorn --workers 1 --timeout 120 --bind unix:/run/myhealthpredicta/gunicorn.sock myowndissertation.wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
